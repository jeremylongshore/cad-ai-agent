# cad-dxf-agent environment configuration
# Copy to .env and fill in values as needed

# LLM Provider (optional — mock mode works without any API key)
# Supported: openai, anthropic, google, mock
CAD_LLM_PROVIDER=mock

# API keys (only needed if using a real LLM provider)
# CAD_OPENAI_API_KEY=
# CAD_ANTHROPIC_API_KEY=
# CAD_GOOGLE_API_KEY=

# LLM model override (provider-specific)
# CAD_LLM_MODEL=

# Protected layers (comma-separated, case-insensitive)
CAD_PROTECTED_LAYERS=TITLE,TITLEBLOCK,SEAL,REVISION

# AI revision notes
CAD_REVISION_NOTES_ENABLED=true
CAD_REVISION_NOTES_LAYER=AI_REV_NOTES

# OpenTelemetry (optional — off by default)
# OTEL_ENABLED=true
# OTEL_EXPORTER=console
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Logging
CAD_LOG_LEVEL=INFO

# Local API server (optional)
# CAD_API_HOST=127.0.0.1
# CAD_API_PORT=8321
